# ラベルプリンターの道具 w-cms-label の systemd の設定（2026-10-30・cmd/w-cms-label）。
# 置き場所: /etc/systemd/system/w-cms-label.service → `sudo systemctl daemon-reload && sudo systemctl enable --now w-cms-label`
#
# 業務サーバーの USB につないだ QL-800（/dev/usb/lp0・組 lp）で札を刷る。w-cms とは Unix ソケット /run/w-cms-label/label.sock
# だけでやりとりする（網には出ない）。
#
# ⚠ 利用者 wcms-label で動かす（w-cms の利用者ではない）。ソケットは wcms-label:wcms-label の 0660 で、組 wcms-label に入れるのは
#   本番の w-cms だけ（w-cms.service の SupplementaryGroups=wcms-label）。試験用（w-cms-test）は組に入らないので、本物の札は刷れない。
#   用意: sudo useradd --system --no-create-home --shell /usr/sbin/nologin --groups lp wcms-label
# ⚠ QL-800 の電源が切れると /dev/usb/lp0 が消える。道具は仕事のたびに開くので、電源を入れ直せば起こし直さずに刷れる。

[Unit]
Description=w-cms ラベルプリンター（QL-800）
After=network.target

[Service]
Type=simple
User=wcms-label
Group=wcms-label
SupplementaryGroups=lp
UMask=0007
RuntimeDirectory=w-cms-label
RuntimeDirectoryMode=0750
ExecStart=/opt/w-cms/w-cms-label -dev /dev/usb/lp0 -sock /run/w-cms-label/label.sock
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/var/lib/w-cms -/run/w-cms -/run/w-cms-test -/opt/w-cms/prod -/opt/w-cms/repo -/etc/w-cms
# USB のプリンターの口（/proc/devices の 180 usb）だけに触れる。
DevicePolicy=closed
DeviceAllow=char-usb rw
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
