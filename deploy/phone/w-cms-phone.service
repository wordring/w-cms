# 電話の道具 w-cms-phone の systemd の設定（2026-10-21 夜・docs/考察/【考察】通信箱の改善.md §7.3）。
# 置き場所: /etc/systemd/system/w-cms-phone.service → `sudo systemctl daemon-reload && sudo systemctl enable --now w-cms-phone`
#
# 鍵は /etc/w-cms/phone.env に `WCMS_MACHINE_TOKEN=<w-cms と同じ鍵>` と書きます（持ち主 root・0600）。
# ND6 を抜いても、道具は数秒おきに開き直し続けます。道具そのものが落ちたら、systemd が起こし直します。

[Unit]
Description=w-cms 電話の着信の記録（アロハ ND6）
After=network-online.target w-cms.service
Wants=network-online.target

[Service]
Type=simple
User=w-cms
Group=dialout
EnvironmentFile=/etc/w-cms/phone.env
# w-cms と同じ機械なら https://localhost:8443。自分で作った証明書なら -insecure（同じ機械の中だけの通り道）。
ExecStart=/opt/w-cms/w-cms-phone -dev /dev/aloha-nd6 -base https://localhost:8443 -insecure
Restart=always
RestartSec=5
# 守り（2026-10-27 の見直し）: 電話の道具は w-cms の利用者で動くが、本番のデータと中の入口には触れさせない
# （機械の入口へは TCP で送るだけ）。ND6 から読む文は外の電話の番号なので、乗っ取られたときに届く所を絞る。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/var/lib/w-cms -/run/w-cms -/run/w-cms-test -/opt/w-cms/prod -/opt/w-cms/repo
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
