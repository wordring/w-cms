# w-cms 本番の systemd の設定（2026-10-25・docs/考察/【考察】職場のサーバー機と社外からの接続.md §2.3・§4）。
# 置き場所: /etc/systemd/system/w-cms.service → `sudo systemctl daemon-reload && sudo systemctl enable --now w-cms`
#
# ⚠ 本番を起こすのは、いまの PC（HP405）から引っ越すとき（§2.4）。2つの本番が同時に動くと、データが分かれます。
# 設定は /etc/w-cms/w-cms.env（持ち主 root・0600）。中身は deploy/server/README.md。
# 画面のファイル（assets/）と設定（config/）は、WorkingDirectory のリポジトリから読みます。
# ⚠ 本番は、試験用（/opt/w-cms/repo）とは別の写し /opt/w-cms/prod を使います（git worktree・試験用で確かめた版に止めておく）。
#   同じ写しを使うと、試験用のために取ってきた新しい画面のファイルが、本番の実行ファイルを替える前に本番にも出てしまうため。
#   入れ替えは w-cms-update prod（deploy/server/w-cms-update）。

[Unit]
Description=w-cms 本番（:8443）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=w-cms
Group=w-cms
WorkingDirectory=/opt/w-cms/prod
EnvironmentFile=/etc/w-cms/w-cms.env
ExecStart=/opt/w-cms/w-cms
Restart=always
RestartSec=3
# 守り: 書けるのはデータの場所だけ。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/w-cms/data
# 業務サーバーの中だけで開く入口（2026-10-26・cmd/w-cms/local_socket.go）の置き場。持ち主（w-cms）だけが入れる——root は sudo で入る。
# 設定の WCMS_LOCAL_SOCKET=/run/w-cms/local.sock と WCMS_LOCAL_SOCKET_USER（この入口の利用者）で開く。
RuntimeDirectory=w-cms
RuntimeDirectoryMode=0700
# 守りを重ねる（2026-10-27 の見直し）——外から届いた PDF を描く mutool も、この中で動く。乗っ取られても、機械の設定・
# ほかの仕事・機械の部品には触れない。
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# メモリの上限（2026-10-27 の見直し）——壊れた PDF・写真・表計算でメモリを食っても、機械ごと詰まらせない（業務サーバーは 30 GB）。
MemoryHigh=6G
MemoryMax=8G

[Install]
WantedBy=multi-user.target
