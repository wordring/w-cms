# w-cms 試験用の systemd の設定（2026-10-25・docs/考察/【考察】職場のサーバー機と社外からの接続.md §2.3・§4）。
# 置き場所: /etc/systemd/system/w-cms-test.service → `sudo systemctl daemon-reload && sudo systemctl enable --now w-cms-test`
#
# 本番（w-cms.service）と同じ形で、データの場所・ポート・実行ファイルだけが違います。
# 設定は /etc/w-cms/test.env（持ち主 root・0600）。中身は deploy/server/README.md。
# 画面のファイル（assets/）と設定（config/）は、WorkingDirectory のリポジトリから読みます。

[Unit]
Description=w-cms 試験用（:9443）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=w-cms
Group=w-cms
WorkingDirectory=/opt/w-cms/repo
EnvironmentFile=/etc/w-cms/test.env
ExecStart=/opt/w-cms/w-cms-test
Restart=always
RestartSec=3
# 守り: 書けるのはデータの場所だけ。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/w-cms/data-test
# 業務サーバーの中だけで開く入口（2026-10-26・cmd/w-cms/local_socket.go）の置き場。持ち主（w-cms）だけが入れる——root は sudo で入る。
# 設定の WCMS_LOCAL_SOCKET=/run/w-cms-test/local.sock と WCMS_LOCAL_SOCKET_USER（この入口の利用者）で開く。
RuntimeDirectory=w-cms-test
RuntimeDirectoryMode=0700
# 守りを重ねる（2026-10-27 の見直し）——外から届いた PDF を描く mutool も、この中で動く。乗っ取られても、機械の設定・
# ほかの仕事・機械の部品には触れない。
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# メモリの上限（2026-10-27 の見直し）——壊れた PDF・写真・表計算でメモリを食っても、機械ごと詰まらせない（業務サーバーは 30 GB）。
MemoryHigh=3G
MemoryMax=4G
# ⚠ 試験用からは本番のデータと本番の中の入口（管理者 Claude）に届かないようにする（2026-10-27 の見直し）。試験用と本番は同じ
# 利用者 w-cms で動くので、これが無いと、試験用を乗っ取った者が本番の利用者の DB・メールの鍵を読み、本番の管理者になれた。
InaccessiblePaths=-/var/lib/w-cms/data -/run/w-cms -/etc/w-cms/tls-public

[Install]
WantedBy=multi-user.target
