# /etc/dnsmasq.d/w-cms.conf — 社内の名前引き（split-horizon・2026-10-26）。
# 公開の名前だけを業務サーバーの社内の住所で答え、ほかの名前はルーターへ回す。
# 社外から引くと、公開の名前は VPS の住所（DNS の会社の A レコード）——社内から引くと業務サーバー。
#
# ⚠ ルーターが配る DNS を業務サーバーにする（ルーターの画面）。2番目の DNS にルーター自身を書いておくと、業務サーバーが
#    止まっても名前は引ける（そのときの公開の名前は VPS の住所が返り、VPS を通って入る——遅いが使える）。
listen-address=〈業務サーバーの社内の住所〉
bind-interfaces
no-resolv
server=〈ルーターの住所〉
domain-needed
bogus-priv
cache-size=1000
host-record=〈公開の名前〉,〈業務サーバーの社内の住所〉
# 公開の名前より下の名前はルーターへ聞き返さない（ルーターの「ローカルドメイン問合せテーブル」で公開の名前をここへ回すので、
# 聞き返すとルーター → ここ → ルーター…と輪になる）。
local=/〈公開の名前〉/
